# Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# MongoDB Atlas connection string
CONNECTION=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# JWT — Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (no trailing slash)
# Example: http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Super Admin Default Seed Credentials
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@onedrop.com
SUPERADMIN_PASSWORD=SuperAdminPass123!
